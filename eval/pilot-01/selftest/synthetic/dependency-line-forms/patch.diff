+
+export async function confirmPayment(paymentId: string, email: string) {
+  const payment = await findPayment(paymentId);
+  if (!payment) throw new Error(`Payment not found: ${paymentId}`);
+  const order = await getOrder(payment.orderId);
+  for (const item of order.items) await checkStock(item.productId);
+  await notifyPaymentReceived(paymentId, email);
+}
