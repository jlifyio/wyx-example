+}
+
+const restockLedger = new Map<string, LocalStock>();
+
+async function findStock(productId: string): Promise<LocalStock | null> {
+  return restockLedger.get(productId) ?? null;
+}
+
+async function updateStock(productId: string, available: number, reserved: number): Promise<void> {
+  restockLedger.set(productId, { available, reserved });
