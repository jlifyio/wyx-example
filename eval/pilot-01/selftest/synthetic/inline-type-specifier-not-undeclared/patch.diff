   await updatePaymentStatus(paymentId, "refunded");
 }
+
+export type PaymentDetails = { amount: number; status: string; processedAt: Date };
+
+export async function getPayment(paymentId: string): Promise<PaymentDetails & { orderId: string }> {
+  const payment = await findPayment(paymentId);
+  if (!payment) throw new Error(`Payment not found: ${paymentId}`);
+  return { orderId: payment.orderId, amount: payment.amount, status: payment.status, processedAt: payment.processedAt };
+}
