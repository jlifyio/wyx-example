+test("processPayment accepts the exact order total", async () => {
+  await insertOrder({ id: "o1", customerId: "c1", items: [], status: "pending", total: 10, createdAt: new Date(), updatedAt: new Date() });
+  expect(typeof (await processPayment("o1", 10))).toBe("string");
+});
