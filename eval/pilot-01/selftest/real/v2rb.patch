 // Payments service
 import { findOrder } from "../orders/repository";
+import { getOrder } from "../orders/service";
+// Hotfix: Inventory's public API has no restock action (reserve/release keep
+// available + reserved constant), so refund writes through the repository.
+// Replace with an Inventory restock action once the Inventory team adds one.
+import { findStock, updateStock } from "../inventory/repository";
 import { insertPayment, findPayment, updatePaymentStatus } from "./repository";
 
 export async function processPayment(orderId: string, amount: number) {
@@ -32,5 +37,18 @@ export async function refund(paymentId: string) {
   const payment = await findPayment(paymentId);
   if (!payment) throw new Error(`Payment not found: ${paymentId}`);
   if (payment.status !== "completed") throw new Error("Can only refund completed payments");
+
+  // Validate every product before mutating, so a missing product leaves no partial restock
+  const order = await getOrder(payment.orderId);
+  for (const item of order.items) {
+    if (!(await findStock(item.productId))) throw new Error(`Product not found: ${item.productId}`);
+  }
+
   await updatePaymentStatus(paymentId, "refunded");
+
+  // Returned items go back to available stock; reserved is untouched
+  for (const item of order.items) {
+    const stock = (await findStock(item.productId))!;
+    await updateStock(item.productId, stock.available + item.quantity, stock.reserved);
+  }
 }
