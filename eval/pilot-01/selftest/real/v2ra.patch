@@ -19,3 +19,9 @@ export async function releaseStock(productId: string, quantity: number) {
   if (!stock) throw new Error(`Product not found: ${productId}`);
   await updateStock(productId, stock.available + quantity, stock.reserved - quantity);
 }
+
+export async function restockStock(productId: string, quantity: number) {
+  const stock = await findStock(productId);
+  if (!stock) throw new Error(`Product not found: ${productId}`);
+  await updateStock(productId, stock.available + quantity, stock.reserved);
+}
