+
+export async function shipOrder(orderId: string) {
+  const order = await getOrder(orderId);
+  if (order.status !== "paid") {
+    throw new Error(`Cannot ship order with status ${order.status}`);
+  }
+
+  // Sum per product so repeated line items are checked against the combined quantity
+  const quantities = new Map<string, number>();
+  for (const item of order.items) {
+    quantities.set(item.productId, (quantities.get(item.productId) ?? 0) + item.quantity);
+  }
+
+  // Validate every product before mutating any, so a failure leaves stock untouched.
+  // Inventory's public API has no action that consumes reserved stock (reserve/release
+  // both preserve available + reserved), so this writes the Inventory repository directly
+  // until Inventory exposes one.
+  const stocks = [];
+  for (const [productId, quantity] of quantities) {
+    const stock = await findStock(productId);
+    if (!stock) throw new Error(`Product not found: ${productId}`);
+    if (stock.reserved < quantity) {
+      throw new Error(`Insufficient reserved stock for ${productId}`);
+    }
+    stocks.push({ stock, quantity });
+  }
+
+  for (const { stock, quantity } of stocks) {
+    await updateStock(stock.productId, stock.available, stock.reserved - quantity);
+  }
+
+  await updateOrderStatus(orderId, "shipped");
+}
